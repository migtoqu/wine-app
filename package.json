{
  "name": "wine-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref mvatmmdifnmqnxikgatp",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types --remote=mvatmmdifnmqnxikgatp --lang typescript --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
